# Run skylinee init to generate a unique key; never commit your actual .env.
SKYLINEE_API_KEY=replace-with-a-unique-random-key
SKYLINEE_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Must be installed in Ollama and advertise "tools" in /api/show.
SKYLINEE_MODEL_AGENT=qwen3:4b
SKYLINEE_MODEL_GENERAL=qwen2.5:1.5b
SKYLINEE_MODEL_CODE=deepseek-coder:1.3b
SKYLINEE_MODEL_SECURITY=qwen2.5:1.5b
SKYLINEE_DATA_DIR=data
SKYLINEE_WORKSPACE_DIR=workspace
SKYLINEE_AUDIT_LOG_PATH=data/audit.jsonl
SKYLINEE_LOG_PROMPT_CONTENT=false
SKYLINEE_REQUEST_TIMEOUT_SECONDS=180
SKYLINEE_AGENT_TIMEOUT_SECONDS=300
SKYLINEE_MAX_AGENT_STEPS=12
SKYLINEE_MAX_TOOL_CHARS=16000
# Optional SearXNG service with JSON format enabled. Blank disables search.
SKYLINEE_SEARXNG_URL=
# Terminal is NOT an OS sandbox; leave disabled until you review commands.
SKYLINEE_ENABLE_TERMINAL=false
SKYLINEE_TERMINAL_ALLOWLIST=python3,git,ls,pwd
